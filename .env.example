# Copy to .env.local for local development. .env* files are gitignored.
#
# Variable taxonomy:
# - NEXT_PUBLIC_* values are inlined into the browser bundle. They are
#   public by design — never put secrets behind the NEXT_PUBLIC_ prefix.
# - Everything else is server-side only and must never appear in client
#   code, docs, tests, CI, or logs.

# Pooled Postgres connection string for runtime queries (Neon pooled
# endpoint, e.g. ...-pooler....neon.tech). SECRET — never commit.
# DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# Direct (unpooled) connection string used by prisma migrate deploy /
# introspection / seed scripts. SECRET — never commit.
# DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require

# Non-secret hostname of the PRODUCTION database. Set on BOTH the Vercel
# Preview and Production environments: scripts/vercel-build.ts uses it
# as a positive identity check — a production build whose URLs do not
# resolve to this host refuses to build, and a preview whose URLs DO
# resolves to it refuses to migrate. Missing value = build fails closed.
# APP_PRODUCTION_DB_HOST=host.region.aws.neon.tech
#
# Non-secret hostname of the permanent `testing` Neon branch — binds
# `npm run db:seed -- --target testing --confirm` to the verified
# testing endpoint so the target name is an identity, not a label.
# APP_TESTING_DB_HOST=host.region.aws.neon.tech
#
# Non-secret hostname of THIS preview's Neon branch (preview/pr-<n>).
# Written per git branch by the neon-preview workflow — never set it
# by hand. The preview build refuses to migrate when DATABASE_URL does
# not resolve to this exact host.
# APP_PREVIEW_DB_HOST=host.region.aws.neon.tech
#
# --- Preview external-service isolation (preview-scoped opt-ins) ---
# Previews must not act on real external services just because their
# environment inherited production-shaped values. Each capability needs
# a deliberate preview-scoped flag; unset = disabled on previews.
# ALLOW_FIREBASE_ADMIN_IN_PREVIEW=true   # Admin SDK on previews — only
#                                        # ever against a dedicated
#                                        # preview Firebase project
# ALLOW_RESEND_IN_PREVIEW=true           # real email on previews — only
#                                        # with a preview Resend key/domain
# ALLOW_S3_IN_PREVIEW=true               # object storage on previews —
#                                        # only a dedicated preview bucket

# Isolated database for *.db.test.ts suites — a dedicated test database
# (e.g. docker-compose local postgres or a Neon dev branch), never the
# dev or preview database you work against interactively. Remote targets
# require TEST_DB_CONFIRM_HOST set to the exact hostname (issue #88).
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sarbase_test

# Canonical site origin (canonical URLs, Open Graph, sitemap, robots).
# NEXT_PUBLIC_SITE_URL=https://example.com

# Canonical app origin — also gates the Secure flag on the session
# cookie (https:// => Secure; also forced for VERCEL_ENV production/preview).
# APP_BASE_URL=https://example.com

# --- Authentication (Firebase Auth) — see docs/authentication.md ---
# Browser-side Firebase web app config. Public by design (NEXT_PUBLIC_*);
# these values identify the project, they are not credentials. When absent
# the sign-in UI reports "authentication is not configured" and every
# protected surface fails closed.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side Firebase Admin service-account credentials — used only to
# verify ID tokens and mint/revoke session cookies. SECRET — never commit;
# set in deployment env only. Paste the private key with \n escapes.
# On Preview deployments these are refused unless
# ALLOW_FIREBASE_ADMIN_IN_PREVIEW=true is set (use a dedicated preview
# Firebase project, never the production service account).
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-...@<project>.iam.gserviceaccount.com
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Notifications (issue #13) — see docs/notifications.md ---
# Explicit provider selection: "resend" or "fake". Optional — when unset,
# the resolver uses Resend if RESEND_API_KEY is present, otherwise the
# deterministic in-process fake in non-production. Production fails
# closed: an unconfigured or fake provider throws instead of silently
# skipping real email.
# NOTIFICATION_PROVIDER=resend
# Resend API key — SECRET; set only in the deployment environment and
# local development, never in CI. Leave unset to use the fake provider.
# RESEND_API_KEY=
# Verified sender identity for outbound mail, e.g.
# "SARbase Notifications <notify@example.org>". Required for resend.
# NOTIFICATION_EMAIL_FROM=
# Pepper for derived callout response tokens (issue #14) — SECRET.
# Response links carry base64url(HMAC-SHA256 of "callout-response:
# <calloutId>:<memberId>") under this key; the raw token is never
# stored, only its SHA-256 hash. REQUIRED in production — activation
# fails closed without it. Non-production falls back to a fixed dev
# value. Rotating it revokes every outstanding response link; the next
# dispatch or retry emails the new derivation and refreshes the stored
# hash.
# CALLOUT_RESPONSE_TOKEN_SECRET=
# Pepper for derived member-invitation tokens — SECRET. Invitation
# emails carry base64url(HMAC-SHA256 of
# "member-invitation:<invitationId>:<tokenVersion>") under this key; the
# raw token is never stored, only its SHA-256 hash. REQUIRED in
# production — issuing an invitation fails closed without it.
# Non-production falls back to a fixed dev value. Rotating it revokes
# every outstanding invitation link at once.
# MEMBER_INVITATION_TOKEN_SECRET=

# --- Observability (Sentry) — all optional; absent = fully disabled ---
# Server-side error reporting DSN. SECRET-adjacent (ingest credential);
# set in deployment environments, not in CI.
# SENTRY_DSN=https://<key>@o<org>.ingest.<region>.sentry.io/<project>
# Browser error reporting DSN — public by design (NEXT_PUBLIC_*).
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.<region>.sentry.io/<project>
# Sourcemap upload credentials — set ONLY in the deployment environment
# (Vercel), never in CI. Without all three, builds skip sourcemap upload.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# --- File storage (issue #16) ---
# Provider selection: "local" (filesystem, dev + self-hosting) or "s3"
# (S3-compatible object store: AWS S3, Cloudflare R2, MinIO). Unset
# defaults to local; production requires an explicit choice via the
# variables below. Objects are PRIVATE — downloads are authorized and
# streamed through /api/attachments/[id]/download; no public URLs exist.
# FILE_STORAGE_PROVIDER=local
# Root directory for the local provider — must be OUTSIDE the repo and
# covered by your filesystem backups (PostgreSQL dumps do not contain
# file bytes). Development default: an OS temp directory.
# FILE_STORAGE_LOCAL_ROOT=/var/lib/sarbase/files
# S3-compatible provider configuration — SECRETS; never in client
# bundles, logs, or CI. The secret access key also derives the HMAC key
# that signs direct-upload grants, so rotating it rotates outstanding
# grants too. Bucket operator requirements (see docs/attachments.md):
# private bucket, CORS allowing POST from the app origin only, and a
# lifecycle rule expiring the `staging/` prefix (abandoned uploads).
# FILE_STORAGE_S3_BUCKET=
# FILE_STORAGE_S3_REGION=
# FILE_STORAGE_S3_ENDPOINT=   # optional — non-AWS endpoints (R2, MinIO)
# FILE_STORAGE_S3_ACCESS_KEY_ID=
# FILE_STORAGE_S3_SECRET_ACCESS_KEY=

# --- Malware scan ingest (GuardDuty Malware Protection for S3) ---
# S3-backed attachments are blocked from download until a verified
# scan result clears them. The result arrives via EventBridge → API
# destination → POST /api/internal/guardduty-scan-result; see
# docs/attachments.md and infra/guardduty-scan-events.yaml for the full
# AWS setup. Both variables below are required for the endpoint to
# accept events — unset means 503, never permissive.
# SECRET shared with the EventBridge connection — generate 32+ random
# chars; must equal the stack's WebhookBearerToken parameter.
# MALWARE_SCAN_WEBHOOK_TOKEN=
# 12-digit AWS account id that owns the bucket — events naming any
# other account are rejected before any write.
# MALWARE_SCAN_AWS_ACCOUNT_ID=
