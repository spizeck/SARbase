{
  "name": "sarbase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:vercel": "tsx scripts/vercel-build.ts",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:react-versions": "node scripts/check-react-versions.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:hosted": "playwright test --config playwright.hosted.config.ts",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:dev": "tsx --env-file-if-exists=.env scripts/migrate.ts dev",
    "db:migrate:reset": "tsx --env-file-if-exists=.env scripts/migrate.ts reset",
    "db:push": "tsx --env-file-if-exists=.env scripts/migrate.ts push",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:verify": "tsx --env-file-if-exists=.env scripts/verify-database.ts",
    "attachments:scan-inventory": "tsx --env-file-if-exists=.env scripts/attachment-scan-inventory.ts",
    "attachments:guardduty-verify": "tsx scripts/guardduty-verify.ts",
    "neon:preview": "tsx scripts/neon-preview.ts",
    "admin:provision": "tsx --env-file-if-exists=.env scripts/provision-admin.ts",
    "db:wait": "tsx scripts/wait-for-postgres.ts",
    "db:backup": "tsx --env-file-if-exists=.env scripts/backup-database.ts",
    "db:restore-drill": "tsx --env-file-if-exists=.env scripts/restore-drill.ts",
    "check:admin-import": "node scripts/check-admin-import.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:react-versions && npm run check:admin-import && npm run test && npm run build"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "jwks-rsa": {
      "jose": "5.10.0"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/s3-presigned-post": "^3.1151.0",
    "@firebase/app": "^0.16.2",
    "@firebase/auth": "^1.13.6",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^11.8.0",
    "firebase-admin": "^14.5.0",
    "libphonenumber-js": "^1.13.14",
    "next": "^16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10",
    "js-yaml": "^4.3.2",
    "prettier": "^3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@prisma/engines": true,
    "prisma": true,
    "@prisma/client": true
  }
}
