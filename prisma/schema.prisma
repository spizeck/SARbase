// SARbase domain schema — see docs/domain-model.md for the semantics,
// cardinality reasoning, and the organization ownership boundary.
// Conventions (cuid ids, createdAt/updatedAt, explicit indexes) are the
// house style carried from the app-foundations production apps.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime queries use the pooled DATABASE_URL. Migrations and
  // introspection should use DATABASE_URL_UNPOOLED — see .env.example.
  url = env("DATABASE_URL")
}

// Administrative lifecycle for a member record. Deactivation preserves
// identity and history; there is no destructive member deletion in the
// application surface (see docs/domain-model.md).
enum MemberStatus {
  ACTIVE
  INACTIVE
}

// Lifecycle for a login identity. DISABLED fails closed on every check —
// a disabled account cannot hold a usable session.
enum AuthIdentityStatus {
  ACTIVE
  DISABLED
}

// Application-level roles within an organization. ADMIN means
// administration of SARbase records — it implies nothing about SAR
// command authority, operational competence, or launch authority.
enum OrgRole {
  MEMBER
  ADMIN
}

// Administrative lifecycle for a qualification definition. INACTIVE
// means the organization no longer assigns new records under the
// definition — it does NOT invalidate or hide historical records.
enum QualificationDefinitionStatus {
  ACTIVE
  INACTIVE
}

// The independent SAR organization that owns its records. Deliberately
// minimal — no billing, federation, or regional hierarchy concepts.
//
// timezone is an IANA identifier (e.g. "America/Puerto_Rico") that
// defines the organization's local calendar date. Qualification and
// other date-only facts compare "today" against this zone — see
// src/lib/dates.ts. Rows migrated before the column existed hold "UTC";
// an org admin should set the real zone in organization settings.
model Organization {
  id        String   @id @default(cuid())
  name      String
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units   Unit[]
  members Member[]

  organizationAccesses     OrganizationAccess[]
  qualificationDefinitions QualificationDefinition[]
  trainingEvents           TrainingEvent[]
  storageLocations         StorageLocation[]
  assets                   Asset[]
  inventoryItems           InventoryItem[]
}

// An internal operational/administrative grouping within an organization
// (station, base, detachment, team, ...). An organization may have zero
// units — units are optional structure, not a requirement.
model Unit {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberUnits    MemberUnit[]
  trainingEvents TrainingEvent[]
  assets         Asset[]
  inventoryItems InventoryItem[]

  // Unit names are unique within an organization (not globally).
  @@unique([organizationId, name])
  // Composite-FK target so MemberUnit can enforce same-organization rows.
  @@unique([id, organizationId])
  @@index([organizationId])
}

// A person belonging to a SAR organization. This is a DOMAIN record —
// it is not an authentication account. A volunteer exists in SARbase
// before (and independently of) any sign-in; a future auth identity
// links TO a member rather than defining one (see issue #6).
model Member {
  id             String       @id @default(cuid())
  organizationId String
  displayName    String
  // Contact points are optional, non-unique, and org-scoped in meaning.
  // A person without email/phone is a valid member; the same email may
  // legitimately appear on multiple members (shared family contact,
  // separate orgs) — uniqueness for sign-in linkage belongs to the auth
  // layer, not this record.
  email          String?
  phone          String?
  status         MemberStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberUnits  MemberUnit[]

  // Qualification evidence rows. Restrict on the composite FK below:
  // a member row can never be hard-deleted while qualification history
  // references it — records are preserved, not convenience-deleted.
  memberQualifications MemberQualification[]

  // Training participation history + optional "led by" pointer on
  // events. Restrict on attendance and its change history: history is
  // preserved.
  trainingAttendances        TrainingAttendance[]
  trainingAttendanceChanges  TrainingAttendanceChange[]
  ledTrainingEvents          TrainingEvent[]             @relation("TrainingLead")

  // Optional link to a login identity. Nullable — most members never sign
  // in. SetNull on identity deletion: removing a login must never destroy
  // the domain person record or its history. One identity may legitimately
  // link to member records in several organizations (the same person
  // volunteering across orgs) — but at most ONE member record per
  // organization per identity (see the composite unique below; Postgres
  // treats NULL authIdentityId values as distinct, so any number of
  // unlinked members coexist).
  authIdentityId String?
  authIdentity   AuthIdentity? @relation(fields: [authIdentityId], references: [id], onDelete: SetNull)

  // Composite-FK target so MemberUnit can enforce same-organization rows.
  @@unique([id, organizationId])
  // At most one linked Member per organization per AuthIdentity.
  @@unique([organizationId, authIdentityId])
  @@index([organizationId, status])
  @@index([email])
  @@index([authIdentityId])
}

// A login identity — NOT the SAR domain person. Created automatically at
// first verified sign-in (with no access); linked to Member records and
// granted organization access explicitly by administrators or the
// bootstrap provisioning script. Deleting an identity must not destroy
// Member history (SetNull on Member.authIdentityId).
model AuthIdentity {
  id          String             @id @default(cuid())
  // e.g. "firebase" — provider-specific, so migrations stay
  // provider-portable and a second provider could coexist.
  provider    String
  providerUid String
  // The account's sign-in email, normalized lowercase. Display/lookup
  // value only — deliberately NOT unique and NOT an authorization input.
  email       String?
  status      AuthIdentityStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  members              Member[]
  organizationAccesses OrganizationAccess[]

  @@unique([provider, providerUid])
  @@index([email])
}

// Explicit organization-scoped authorization for a login identity. This
// relation — not MemberUnit membership, not email matching — is the sole
// source of organization access and role. One row per (identity, org);
// the role column is the extensible point for future roles.
model OrganizationAccess {
  id             String   @id @default(cuid())
  organizationId String
  authIdentityId String
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  authIdentity  AuthIdentity  @relation(fields: [authIdentityId], references: [id], onDelete: Cascade)

  @@unique([authIdentityId, organizationId])
  @@index([organizationId])
}

// An organization-defined qualification/certification type — the org's
// own policy about what it tracks ("we record CPR certificates"), NOT
// any member's evidence. Deliberately minimal: no rank, competency
// score, mission eligibility, minimum-crew, or readiness semantics —
// SARbase records facts; it does not judge fitness for a mission.
// INACTIVE stops new assignment; historical records are untouched.
model QualificationDefinition {
  id             String                        @id @default(cuid())
  organizationId String
  name           String
  description    String?
  status         QualificationDefinitionStatus @default(ACTIVE)
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberQualifications MemberQualification[]

  // Definition names are unique within an organization (not globally).
  @@unique([organizationId, name])
  // Composite-FK target so MemberQualification can enforce
  // same-organization rows at the database level.
  @@unique([id, organizationId])
  @@index([organizationId])
}

// One certificate/qualification record linking a Member to a
// QualificationDefinition — "Nicky received this CPR certificate on X
// date, issued by Y, expiring Z". This is an APPEND-ONLY history row:
// renewals create a new record rather than overwriting, and the
// (memberId, definitionId) pair may therefore repeat. Corrections to
// clerical detail edit the row in place (durable who/what/when history
// is deferred to the audit-history work). Dates are date-only
// (@db.Date) — a certificate's expiry is a calendar date, not an
// instant, so timezone cannot shift it a day early or late.
//
// The denormalized organizationId plus composite FKs make a definition
// from another organization physically unassignable — the same
// mechanism as MemberUnit.
//
// Issue #16 attachments: certificate files will later hang off this
// record's id — deliberately no URL/blob column stands in for that.
model MemberQualification {
  id             String   @id @default(cuid())
  organizationId String
  memberId       String
  definitionId   String
  issuedOn       DateTime? @db.Date
  expiresOn      DateTime? @db.Date
  issuer         String?
  reference      String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  member     Member                  @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Restrict)
  definition QualificationDefinition @relation(fields: [definitionId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([memberId])
  @@index([definitionId])
  // Expiry-window queries (expiring-soon lists, future reminders).
  @@index([organizationId, expiresOn])
}

// Member ↔ Unit assignment. A member may belong to zero, one, or several
// units of their organization. The denormalized organizationId exists so
// the composite foreign keys below can guarantee — at the database level,
// not just in application code — that a member is only ever assigned to
// units of their own organization.
model MemberUnit {
  id             String   @id @default(cuid())
  organizationId String
  memberId       String
  unitId         String
  createdAt      DateTime @default(now())

  member Member @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Cascade)
  unit   Unit   @relation(fields: [unitId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([memberId, unitId])
  @@index([unitId])
}

enum TrainingEventStatus {
  COMPLETED
  CANCELLED
}

// One factual training activity. `date` is the organization's local
// calendar date (@db.Date — same semantics as qualification dates, see
// Organization.timezone / src/lib/dates.ts); `durationMinutes` is the
// whole-event length and the future volunteer-hours source for all
// attendees. No scores, pass/fail, rank, or eligibility fields exist —
// SARbase records that training happened, never what it proves.
//
// Optional unitId/leadMemberId carry organizationId in composite FKs:
// Postgres MATCH SIMPLE skips the check when the component is NULL,
// and enforces same-organization when present.
//
// Lifecycle: COMPLETED (the training happened) or CANCELLED (it was
// planned/recorded but did not occur). CANCELLED keeps the row and any
// attendance rows for history, but they are excluded from
// participation views — attendees are never presented as having
// attended something that did not happen. There is no DRAFT: training
// recordkeeping is historical, not a scheduling workflow.
//
// Issue #16 attachments: training documents/attendance sheets will
// later hang off this record's id — deliberately no URL/blob column.
model TrainingEvent {
  id              String              @id @default(cuid())
  organizationId  String
  unitId          String?
  title           String
  date            DateTime            @db.Date
  durationMinutes Int?
  location        String?
  instructorName  String?
  leadMemberId    String?
  notes           String?
  followUp        String?
  status          TrainingEventStatus @default(COMPLETED)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  unit              Unit?           @relation(fields: [unitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  leadMember        Member?         @relation("TrainingLead", fields: [leadMemberId, organizationId], references: [id, organizationId], onDelete: SetNull)
  attendances       TrainingAttendance[]
  attendanceChanges TrainingAttendanceChange[]
  topics            TrainingTopic[]

  // Composite-FK target for attendance/topics.
  @@unique([id, organizationId])
  @@index([organizationId, date])
  @@index([unitId])
}

// A factual label describing what was practiced — the organization's
// own vocabulary, one row per topic (no comma-blobs) so future search
// and reporting stay relational. Cascade: topics are part of the
// event record itself, not independent history.
model TrainingTopic {
  id              String @id @default(cuid())
  organizationId  String
  trainingEventId String
  label           String
  createdAt       DateTime @default(now())

  event TrainingEvent @relation(fields: [trainingEventId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([trainingEventId, label])
  @@index([label])
}

// "This member attended this training event" — row existence is the
// fact; there is deliberately no attendance taxonomy (no excused/
// unavailable grading). Notes allow per-attendee factual detail.
// Same-organization integrity via composite FKs — a member from org B
// physically cannot attend an event in org A.
model TrainingAttendance {
  id              String   @id @default(cuid())
  organizationId  String
  trainingEventId String
  memberId        String
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event  TrainingEvent @relation(fields: [trainingEventId, organizationId], references: [id, organizationId], onDelete: Restrict)
  member Member        @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([trainingEventId, memberId])
  @@index([memberId])
}

// Immutable attendance-history action. A TrainingAttendanceChange row
// is an append-only fact — the application exposes no update or delete
// path for it.
enum TrainingAttendanceAction {
  ADDED
  REMOVED
}

// Append-only domain audit record for attendance edits — the durable
// who/what/when behind "attendance edits are auditable" (issue #9).
// Every member added to or removed from an event's attendance writes
// one row here inside the same transaction as the attendance mutation
// itself. This is deliberately NOT the deferred generic audit
// framework — a small immutable history for this one fact only.
//
// Preservation choices:
// - Composite FKs to TrainingEvent(id, organizationId) and
//   Member(id, organizationId) enforce same-organization integrity at
//   the database level — a cross-organization audit row is physically
//   impossible — and are Restrict: an event or member row with audit
//   history cannot be hard-deleted underneath it. Removing the CURRENT
//   TrainingAttendance row never touches these rows, so re-adding a
//   member produces a second immutable entry rather than rewriting
//   history.
// - actorAuthIdentityId is deliberately a PLAIN reference, not a
//   foreign key. An FK would either pin identities forever (Restrict)
//   or erase the actor on identity removal (SetNull) — and audit
//   history that disappears with the actor is not audit history. The
//   stored id remains a stable forensic reference after the
//   AuthIdentity is disabled or deleted; while the row exists the UI
//   resolves it to a friendly name, and after removal it renders as a
//   safe fallback identifier.
model TrainingAttendanceChange {
  id                  String                     @id @default(cuid())
  organizationId      String
  trainingEventId     String
  memberId            String
  actorAuthIdentityId String
  action              TrainingAttendanceAction
  createdAt           DateTime                   @default(now())

  event  TrainingEvent @relation(fields: [trainingEventId, organizationId], references: [id, organizationId], onDelete: Restrict)
  member Member        @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([trainingEventId, createdAt])
  @@index([memberId])
  @@index([organizationId])
}

/* ------------------------------------------------------------------ */
/* Issue #10 — assets, inventory, storage locations                    */
/* ------------------------------------------------------------------ */

// Administrative lifecycle for a storage location. ARCHIVED preserves
// the node and everything that references it; there is no delete path
// in the application surface.
enum StorageLocationStatus {
  ACTIVE
  ARCHIVED
}

// Administrative lifecycle for a durable asset. Every transition is an
// explicit human choice — nothing is derived from dates, stock levels,
// or defects. INACTIVE means "not currently in use" (stored, seasonal,
// spare); OUT_OF_SERVICE means a person marked it so (it is NOT an
// inspection result — issue #11); RETIRED means permanently withdrawn.
// None of these values is a safety or readiness conclusion.
enum AssetStatus {
  ACTIVE
  INACTIVE
  OUT_OF_SERVICE
  RETIRED
}

// Human-recorded physical condition — a clerk's note about what someone
// observed, never an inspection-derived or safety-grade value. UNKNOWN
// is the default so no record pretends to a condition nobody stated.
// Structured condition evidence belongs to inspections (issue #11).
enum ConditionStatus {
  UNKNOWN
  GOOD
  FAIR
  DAMAGED
}

enum InventoryItemStatus {
  ACTIVE
  ARCHIVED
}

// A place where assets and stock physically live, arbitrarily nested:
// "SAR Building > Workshop > Shelf A > Cabinet 2". A location sits
// inside exactly ONE container — either a parent location or an Asset
// it is physically part of ("Forward locker" inside "Rescue Boat 1",
// so a vessel's lockers hang off the boat's single identity rather than
// a duplicate location named after it). The parentLocationId /
// containingAssetId mutual exclusion is enforced in the domain layer
// (Prisma cannot express the XOR); composite FKs keep both inside the
// organization at the database level. Cycle prevention is likewise
// domain-enforced — a location can never contain itself transitively.
model StorageLocation {
  id                String   @id @default(cuid())
  organizationId    String
  parentLocationId  String?
  containingAssetId String?
  name              String
  description       String?
  status            StorageLocationStatus @default(ACTIVE)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parentLocation   StorageLocation?  @relation("LocationNesting", fields: [parentLocationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  childLocations   StorageLocation[] @relation("LocationNesting")
  containingAsset  Asset?            @relation("AssetContainedLocations", fields: [containingAssetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  storedAssets     Asset[]           @relation("AssetStorage")
  inventoryItems   InventoryItem[]

  // Composite-FK target so children/containers enforce same-organization
  // rows at the database level.
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([parentLocationId])
  @@index([containingAssetId])
}

// A durable, individually identifiable thing the organization owns —
// a rescue boat, engine, VHF radio, AED, toolbox. Deliberately a flat
// record with optional identity fields: no per-type subtype tables, no
// equipment taxonomy enforced by schema. `category` is the
// organization's own free-text vocabulary ("boat", "radio", "medical")
// — bounded text, not an enum, so no enum churn as orgs differ.
//
// Relationships:
// - storageLocationId — where it is kept (nullable: unplaced is valid).
// - parentAssetId — physical/administrative containment only
//   ("port engine is part of Rescue Boat 1"). It is NOT an operational
//   dependency graph and asserts nothing about fitness; a child asset
//   keeps its own identity and its own optional storage location (an
//   engine can be part of a boat and temporarily stored in the
//   workshop). Same-org and acyclic, enforced in domain + composite FK.
// - unitId — optional administrative ownership by an internal unit.
//
// `serialNumber` is deliberately NOT unique (manufacturers can reuse
// them); `assetTag` is the organization's own tag and is unique per
// organization when present (NULLs are distinct, so untagged assets
// are unrestricted).
//
// Current location is a mutable fact; durable location/movement
// history is deferred to the generic audit-history work — same
// posture as event-detail edits.
model Asset {
  id                String   @id @default(cuid())
  organizationId    String
  unitId            String?
  parentAssetId     String?
  storageLocationId String?
  name              String
  category          String?
  manufacturer      String?
  model             String?
  serialNumber      String?
  assetTag          String?
  purchaseDate      DateTime? @db.Date
  // Free-text "where did we buy it" memory. A real Vendor record is
  // deferred to expenses (#17) — this field may later migrate onto it.
  vendor            String?
  status            AssetStatus     @default(ACTIVE)
  condition         ConditionStatus @default(UNKNOWN)
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  unit               Unit?             @relation(fields: [unitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  parentAsset        Asset?            @relation("AssetChildren", fields: [parentAssetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  childAssets        Asset[]           @relation("AssetChildren")
  storageLocation    StorageLocation?  @relation("AssetStorage", fields: [storageLocationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  containedLocations StorageLocation[] @relation("AssetContainedLocations")

  // Composite-FK targets so locations/children/units enforce
  // same-organization rows at the database level.
  @@unique([id, organizationId])
  // Optional org-scoped asset tag — NULLs are distinct in Postgres, so
  // untagged assets never collide.
  @@unique([organizationId, assetTag])
  @@index([organizationId, status])
  @@index([organizationId, category])
  @@index([serialNumber])
  @@index([unitId])
  @@index([parentAssetId])
  @@index([storageLocationId])
}

// A quantity-tracked stock item — rope, flares, gloves, batteries,
// first-aid consumables. Deliberately separate from Asset: identity
// fields (serial/tag/parent/contained locations) would be null-noise
// on bulk stock, and quantity/unitOfMeasure would be meaningless on a
// unique asset. `quantity` is an exact DECIMAL(14,3) — "25 m of line"
// or "1.5 gallons cleaner" are legitimate facts; floats would lie.
// No lot tracking, reorder points, FIFO, or stock transactions —
// quantity is simply "how many we have now".
model InventoryItem {
  id                String   @id @default(cuid())
  organizationId    String
  unitId            String?
  storageLocationId String?
  name              String
  category          String?
  quantity          Decimal   @db.Decimal(14, 3)
  unitOfMeasure     String?
  // Free-text purchase-source memory, same deferral as Asset.vendor.
  vendor            String?
  condition         ConditionStatus     @default(UNKNOWN)
  status            InventoryItemStatus @default(ACTIVE)
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  unit            Unit?            @relation(fields: [unitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  storageLocation StorageLocation? @relation(fields: [storageLocationId, organizationId], references: [id, organizationId], onDelete: Restrict)

  // Composite-FK target for future same-organization children
  // (e.g. inspections in issue #11).
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, category])
  @@index([storageLocationId])
}
