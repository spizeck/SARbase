// SARbase domain schema — see docs/domain-model.md for the semantics,
// cardinality reasoning, and the organization ownership boundary.
// Conventions (cuid ids, createdAt/updatedAt, explicit indexes) are the
// house style carried from the app-foundations production apps.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime queries use the pooled DATABASE_URL. Migrations and
  // introspection should use DATABASE_URL_UNPOOLED — see .env.example.
  url      = env("DATABASE_URL")
}

// Administrative lifecycle for a member record. Deactivation preserves
// identity and history; there is no destructive member deletion in the
// application surface (see docs/domain-model.md).
enum MemberStatus {
  ACTIVE
  INACTIVE
}

// Lifecycle for a login identity. DISABLED fails closed on every check —
// a disabled account cannot hold a usable session.
enum AuthIdentityStatus {
  ACTIVE
  DISABLED
}

// Application-level roles within an organization. ADMIN means
// administration of SARbase records — it implies nothing about SAR
// command authority, operational competence, or launch authority.
enum OrgRole {
  MEMBER
  ADMIN
}

// Administrative lifecycle for a qualification definition. INACTIVE
// means the organization no longer assigns new records under the
// definition — it does NOT invalidate or hide historical records.
enum QualificationDefinitionStatus {
  ACTIVE
  INACTIVE
}

// The independent SAR organization that owns its records. Deliberately
// minimal — no billing, federation, or regional hierarchy concepts.
//
// timezone is an IANA identifier (e.g. "America/Puerto_Rico") that
// defines the organization's local calendar date. Qualification and
// other date-only facts compare "today" against this zone — see
// src/lib/dates.ts. Rows migrated before the column existed hold "UTC";
// an org admin should set the real zone in organization settings.
model Organization {
  id        String   @id @default(cuid())
  name      String
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units   Unit[]
  members Member[]

  organizationAccesses     OrganizationAccess[]
  qualificationDefinitions QualificationDefinition[]
  trainingEvents           TrainingEvent[]
  storageLocations         StorageLocation[]
  assets                   Asset[]
  inventoryItems           InventoryItem[]
  inspectionDefinitions    InspectionDefinition[]
  inspectionRecords        InspectionRecord[]
  inspectionRecordChanges  InspectionRecordChange[]
  maintenancePlans         MaintenancePlan[]
  maintenanceRecords       MaintenanceRecord[]
  maintenanceRecordChanges MaintenanceRecordChange[]
  defects                  Defect[]
  defectChanges            DefectChange[]
  assetMeters              AssetMeter[]
  assetMeterReadings       AssetMeterReading[]

  availabilityUpdates     MemberAvailabilityUpdate[]
  notificationPreferences MemberNotificationPreference[]
  notifications           Notification[]
  notificationAttempts    NotificationAttempt[]

  callouts               Callout[]
  calloutInvitations     CalloutInvitation[]
  calloutResponseChanges CalloutResponseChange[]

  incidents               Incident[]
  incidentSequences       IncidentSequence[]
  incidentMembers         IncidentMember[]
  incidentAssets          IncidentAsset[]
  incidentTimelineEvents  IncidentTimelineEvent[]
  incidentNotes           IncidentNote[]
  incidentNoteCorrections IncidentNoteCorrection[]
  incidentChanges         IncidentChange[]
}

// An internal operational/administrative grouping within an organization
// (station, base, detachment, team, ...). An organization may have zero
// units — units are optional structure, not a requirement.
model Unit {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberUnits    MemberUnit[]
  trainingEvents TrainingEvent[]
  assets         Asset[]
  inventoryItems InventoryItem[]
  callouts       Callout[]

  // Unit names are unique within an organization (not globally).
  @@unique([organizationId, name])
  // Composite-FK target so MemberUnit can enforce same-organization rows.
  @@unique([id, organizationId])
  @@index([organizationId])
}

// A person belonging to a SAR organization. This is a DOMAIN record —
// it is not an authentication account. A volunteer exists in SARbase
// before (and independently of) any sign-in; a future auth identity
// links TO a member rather than defining one (see issue #6).
model Member {
  id             String       @id @default(cuid())
  organizationId String
  displayName    String
  // Contact points are optional, non-unique, and org-scoped in meaning.
  // A person without email/phone is a valid member; the same email may
  // legitimately appear on multiple members (shared family contact,
  // separate orgs) — uniqueness for sign-in linkage belongs to the auth
  // layer, not this record.
  email          String?
  phone          String?
  status         MemberStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberUnits  MemberUnit[]

  // Qualification evidence rows. Restrict on the composite FK below:
  // a member row can never be hard-deleted while qualification history
  // references it — records are preserved, not convenience-deleted.
  memberQualifications MemberQualification[]

  // Training participation history + optional "led by" pointer on
  // events. Restrict on attendance and its change history: history is
  // preserved.
  trainingAttendances       TrainingAttendance[]
  trainingAttendanceChanges TrainingAttendanceChange[]
  ledTrainingEvents         TrainingEvent[]            @relation("TrainingLead")

  // Optional "who" pointers on issue #11 records — Restrict so member
  // rows can't be hard-deleted out from under recorded history.
  inspectionsPerformed  InspectionRecord[]
  maintenancePerformed  MaintenanceRecord[]
  defectsReported       Defect[]
  meterReadingsRecorded AssetMeterReading[]

  // Issue #12 — availability statements are append-only history; the
  // notification-preference row is the member's mutable channel config.
  availabilityUpdates    MemberAvailabilityUpdate[]
  notificationPreference MemberNotificationPreference?

  // Issue #13 — notification requests that targeted this member.
  // Restrict: a member row cannot be hard-deleted out from under
  // recorded send history.
  notifications Notification[]

  // Issue #14 — callout invitations materialized for this member.
  // Restrict: invited history outlives membership changes.
  calloutInvitations CalloutInvitation[]

  // Issue #15 — explicit incident participation records. Restrict:
  // a member row can't be hard-deleted out from under incident history.
  incidentParticipations IncidentMember[]

  // Optional link to a login identity. Nullable — most members never sign
  // in. SetNull on identity deletion: removing a login must never destroy
  // the domain person record or its history. One identity may legitimately
  // link to member records in several organizations (the same person
  // volunteering across orgs) — but at most ONE member record per
  // organization per identity (see the composite unique below; Postgres
  // treats NULL authIdentityId values as distinct, so any number of
  // unlinked members coexist).
  authIdentityId String?
  authIdentity   AuthIdentity? @relation(fields: [authIdentityId], references: [id], onDelete: SetNull)

  // Composite-FK target so MemberUnit can enforce same-organization rows.
  @@unique([id, organizationId])
  // At most one linked Member per organization per AuthIdentity.
  @@unique([organizationId, authIdentityId])
  @@index([organizationId, status])
  @@index([email])
  @@index([authIdentityId])
}

// A login identity — NOT the SAR domain person. Created automatically at
// first verified sign-in (with no access); linked to Member records and
// granted organization access explicitly by administrators or the
// bootstrap provisioning script. Deleting an identity must not destroy
// Member history (SetNull on Member.authIdentityId).
model AuthIdentity {
  id          String             @id @default(cuid())
  // e.g. "firebase" — provider-specific, so migrations stay
  // provider-portable and a second provider could coexist.
  provider    String
  providerUid String
  // The account's sign-in email, normalized lowercase. Display/lookup
  // value only — deliberately NOT unique and NOT an authorization input.
  email       String?
  status      AuthIdentityStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  members                  Member[]
  organizationAccesses     OrganizationAccess[]
  defectChanges            DefectChange[]
  inspectionRecordChanges  InspectionRecordChange[]
  maintenanceRecordChanges MaintenanceRecordChange[]
  // MemberAvailabilityUpdate.actorAuthIdentityId is a plain scalar
  // reference (no back-relation) — history outlives the identity.

  @@unique([provider, providerUid])
  @@index([email])
}

// Explicit organization-scoped authorization for a login identity. This
// relation — not MemberUnit membership, not email matching — is the sole
// source of organization access and role. One row per (identity, org);
// the role column is the extensible point for future roles.
model OrganizationAccess {
  id             String   @id @default(cuid())
  organizationId String
  authIdentityId String
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  authIdentity AuthIdentity @relation(fields: [authIdentityId], references: [id], onDelete: Cascade)

  @@unique([authIdentityId, organizationId])
  @@index([organizationId])
}

// An organization-defined qualification/certification type — the org's
// own policy about what it tracks ("we record CPR certificates"), NOT
// any member's evidence. Deliberately minimal: no rank, competency
// score, mission eligibility, minimum-crew, or readiness semantics —
// SARbase records facts; it does not judge fitness for a mission.
// INACTIVE stops new assignment; historical records are untouched.
model QualificationDefinition {
  id             String                        @id @default(cuid())
  organizationId String
  name           String
  description    String?
  status         QualificationDefinitionStatus @default(ACTIVE)
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberQualifications MemberQualification[]

  // Definition names are unique within an organization (not globally).
  @@unique([organizationId, name])
  // Composite-FK target so MemberQualification can enforce
  // same-organization rows at the database level.
  @@unique([id, organizationId])
  @@index([organizationId])
}

// One certificate/qualification record linking a Member to a
// QualificationDefinition — "Nicky received this CPR certificate on X
// date, issued by Y, expiring Z". This is an APPEND-ONLY history row:
// renewals create a new record rather than overwriting, and the
// (memberId, definitionId) pair may therefore repeat. Corrections to
// clerical detail edit the row in place (durable who/what/when history
// is deferred to the audit-history work). Dates are date-only
// (@db.Date) — a certificate's expiry is a calendar date, not an
// instant, so timezone cannot shift it a day early or late.
//
// The denormalized organizationId plus composite FKs make a definition
// from another organization physically unassignable — the same
// mechanism as MemberUnit.
//
// Issue #16 attachments: certificate files will later hang off this
// record's id — deliberately no URL/blob column stands in for that.
model MemberQualification {
  id             String    @id @default(cuid())
  organizationId String
  memberId       String
  definitionId   String
  issuedOn       DateTime? @db.Date
  expiresOn      DateTime? @db.Date
  issuer         String?
  reference      String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  member     Member                  @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Restrict)
  definition QualificationDefinition @relation(fields: [definitionId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([memberId])
  @@index([definitionId])
  // Expiry-window queries (expiring-soon lists, future reminders).
  @@index([organizationId, expiresOn])
}

// Member ↔ Unit assignment. A member may belong to zero, one, or several
// units of their organization. The denormalized organizationId exists so
// the composite foreign keys below can guarantee — at the database level,
// not just in application code — that a member is only ever assigned to
// units of their own organization.
model MemberUnit {
  id             String   @id @default(cuid())
  organizationId String
  memberId       String
  unitId         String
  createdAt      DateTime @default(now())

  member Member @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Cascade)
  unit   Unit   @relation(fields: [unitId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([memberId, unitId])
  @@index([unitId])
}

enum TrainingEventStatus {
  COMPLETED
  CANCELLED
}

// One factual training activity. `date` is the organization's local
// calendar date (@db.Date — same semantics as qualification dates, see
// Organization.timezone / src/lib/dates.ts); `durationMinutes` is the
// whole-event length and the future volunteer-hours source for all
// attendees. No scores, pass/fail, rank, or eligibility fields exist —
// SARbase records that training happened, never what it proves.
//
// Optional unitId/leadMemberId carry organizationId in composite FKs:
// Postgres MATCH SIMPLE skips the check when the component is NULL,
// and enforces same-organization when present.
//
// Lifecycle: COMPLETED (the training happened) or CANCELLED (it was
// planned/recorded but did not occur). CANCELLED keeps the row and any
// attendance rows for history, but they are excluded from
// participation views — attendees are never presented as having
// attended something that did not happen. There is no DRAFT: training
// recordkeeping is historical, not a scheduling workflow.
//
// Issue #16 attachments: training documents/attendance sheets will
// later hang off this record's id — deliberately no URL/blob column.
model TrainingEvent {
  id              String              @id @default(cuid())
  organizationId  String
  unitId          String?
  title           String
  date            DateTime            @db.Date
  durationMinutes Int?
  location        String?
  instructorName  String?
  leadMemberId    String?
  notes           String?
  followUp        String?
  status          TrainingEventStatus @default(COMPLETED)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  unit              Unit?                      @relation(fields: [unitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  leadMember        Member?                    @relation("TrainingLead", fields: [leadMemberId, organizationId], references: [id, organizationId], onDelete: SetNull)
  attendances       TrainingAttendance[]
  attendanceChanges TrainingAttendanceChange[]
  topics            TrainingTopic[]

  // Composite-FK target for attendance/topics.
  @@unique([id, organizationId])
  @@index([organizationId, date])
  @@index([unitId])
}

// A factual label describing what was practiced — the organization's
// own vocabulary, one row per topic (no comma-blobs) so future search
// and reporting stay relational. Cascade: topics are part of the
// event record itself, not independent history.
model TrainingTopic {
  id              String   @id @default(cuid())
  organizationId  String
  trainingEventId String
  label           String
  createdAt       DateTime @default(now())

  event TrainingEvent @relation(fields: [trainingEventId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([trainingEventId, label])
  @@index([label])
}

// "This member attended this training event" — row existence is the
// fact; there is deliberately no attendance taxonomy (no excused/
// unavailable grading). Notes allow per-attendee factual detail.
// Same-organization integrity via composite FKs — a member from org B
// physically cannot attend an event in org A.
model TrainingAttendance {
  id              String   @id @default(cuid())
  organizationId  String
  trainingEventId String
  memberId        String
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event  TrainingEvent @relation(fields: [trainingEventId, organizationId], references: [id, organizationId], onDelete: Restrict)
  member Member        @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([trainingEventId, memberId])
  @@index([memberId])
}

// Immutable attendance-history action. A TrainingAttendanceChange row
// is an append-only fact — the application exposes no update or delete
// path for it.
enum TrainingAttendanceAction {
  ADDED
  REMOVED
}

// Append-only domain audit record for attendance edits — the durable
// who/what/when behind "attendance edits are auditable" (issue #9).
// Every member added to or removed from an event's attendance writes
// one row here inside the same transaction as the attendance mutation
// itself. This is deliberately NOT the deferred generic audit
// framework — a small immutable history for this one fact only.
//
// Preservation choices:
// - Composite FKs to TrainingEvent(id, organizationId) and
//   Member(id, organizationId) enforce same-organization integrity at
//   the database level — a cross-organization audit row is physically
//   impossible — and are Restrict: an event or member row with audit
//   history cannot be hard-deleted underneath it. Removing the CURRENT
//   TrainingAttendance row never touches these rows, so re-adding a
//   member produces a second immutable entry rather than rewriting
//   history.
// - actorAuthIdentityId is deliberately a PLAIN reference, not a
//   foreign key. An FK would either pin identities forever (Restrict)
//   or erase the actor on identity removal (SetNull) — and audit
//   history that disappears with the actor is not audit history. The
//   stored id remains a stable forensic reference after the
//   AuthIdentity is disabled or deleted; while the row exists the UI
//   resolves it to a friendly name, and after removal it renders as a
//   safe fallback identifier.
// ---------------------------------------------------------------------------
// Issue #11 — inspections, maintenance history, defects, and due tracking.
//
// All records below are factual and administrative: they record that an
// inspection occurred, service was performed, a defect was reported, or a
// due date/threshold exists. Nothing in this subsystem asserts that an
// asset is safe, ready, deployable, or unfit — those are human decisions.
// Every record carries a denormalized organizationId so composite foreign
// keys enforce same-organization integrity at the database layer exactly
// like issue #10's containment graph. Targets are Asset only; inventory
// consumable expiry is deliberately deferred.
// ---------------------------------------------------------------------------

enum InspectionDefinitionStatus {
  ACTIVE
  INACTIVE
}

enum RecurrenceType {
  NONE
  CALENDAR_DAYS
  CALENDAR_MONTHS
  METER_INTERVAL
}

enum MaintenancePlanStatus {
  ACTIVE
  INACTIVE
}

enum DefectStatus {
  OPEN
  RESOLVED
}

enum DefectAction {
  REPORTED
  RESOLVED
  REOPENED
}

enum AssetMeterStatus {
  ACTIVE
  ARCHIVED
}

/// What an organization tracks (e.g. "Monthly vessel visual inspection").
/// Calendar recurrence only: recurring requirements tied to meter readings
/// are modeled as MaintenancePlan rows instead. Deactivating preserves
/// history but blocks new inspection records.
model InspectionDefinition {
  id             String                     @id @default(cuid())
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationId String
  name           String
  description    String?
  recurrenceType RecurrenceType             @default(NONE)
  intervalValue  Int? // days or months, matching recurrenceType; null for NONE
  status         InspectionDefinitionStatus @default(ACTIVE)
  records        InspectionRecord[]
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@unique([organizationId, name])
  // Composite target so child records prove same-organization at the FK.
  @@unique([id, organizationId])
  @@index([organizationId, status])
}

/// A factual inspection occurrence against one asset. No verdict enum: the
/// record's existence states the inspection happened; findings live in
/// notes/conditionObserved and any defects a human chooses to report.
/// nextDueOn is an explicit date-only fact — pre-filled from the
/// definition's recurrence when recording, freely overridable.
model InspectionRecord {
  id                String                   @id @default(cuid())
  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationId    String
  asset             Asset                    @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assetId           String
  definition        InspectionDefinition     @relation(fields: [definitionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  definitionId      String
  performedOn       DateTime                 @db.Date
  inspectorMember   Member?                  @relation(fields: [inspectorMemberId, organizationId], references: [id, organizationId], onDelete: Restrict)
  inspectorMemberId String?
  inspectorName     String? // free-text inspector (e.g. external surveyor)
  conditionObserved ConditionStatus? // clerk-recorded observation, never a readiness verdict
  nextDueOn         DateTime?                @db.Date
  meter             AssetMeter?              @relation(fields: [meterId, organizationId], references: [id, organizationId], onDelete: Restrict)
  meterId           String?
  meterReading      Decimal?                 @db.Decimal(14, 3)
  notes             String?
  meterReadings     AssetMeterReading[]      @relation("MeterReadingInspectionSource")
  changes           InspectionRecordChange[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  // Composite target for AssetMeterReading.inspectionRecord provenance.
  @@unique([id, organizationId])
  @@index([organizationId, assetId, performedOn])
  @@index([organizationId, definitionId])
}

/// Append-only correction history for an InspectionRecord — the "corrections
/// preserve material history" requirement. Each row snapshots every material
/// field before and after the correction and is written in the same
/// transaction as the record update, so a material correction cannot commit
/// without its history. Asset/definition/meter provenance are immutable and
/// not duplicated here. actorAuthIdentityId is the server-side sign-in
/// identity — never client-supplied; Restrict keeps history intact because
/// an identity cannot be deleted while it has authored changes. Member-id
/// snapshots are stored as plain values (what the field contained), not
/// live references.
model InspectionRecordChange {
  id             String           @id @default(cuid())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationId String
  record         InspectionRecord @relation(fields: [recordId, organizationId], references: [id, organizationId], onDelete: Restrict)
  recordId       String
  note           String? // optional human reason for the correction

  beforePerformedOn       DateTime         @db.Date
  beforeInspectorMemberId String?
  beforeInspectorName     String?
  beforeConditionObserved ConditionStatus?
  beforeNextDueOn         DateTime?        @db.Date
  beforeNotes             String?
  afterPerformedOn        DateTime         @db.Date
  afterInspectorMemberId  String?
  afterInspectorName      String?
  afterConditionObserved  ConditionStatus?
  afterNextDueOn          DateTime?        @db.Date
  afterNotes              String?
  actorAuthIdentity       AuthIdentity     @relation(fields: [actorAuthIdentityId], references: [id], onDelete: Restrict)
  actorAuthIdentityId     String
  createdAt               DateTime         @default(now())

  @@index([recordId, createdAt])
  @@index([organizationId])
}

/// A per-asset recurring maintenance requirement ("engine oil every 100
/// hours", "annual haul-out"). Due state is derived at read time from the
/// plan plus its latest record — never inferred as readiness.
model MaintenancePlan {
  id             String                @id @default(cuid())
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationId String
  asset          Asset                 @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assetId        String
  name           String
  description    String?
  intervalType   RecurrenceType        @default(NONE)
  intervalValue  Int? // days or months when intervalType is calendar-based
  meter          AssetMeter?           @relation(fields: [meterId, organizationId], references: [id, organizationId], onDelete: Restrict)
  meterId        String? // required when intervalType is METER_INTERVAL
  meterInterval  Decimal?              @db.Decimal(14, 3)
  status         MaintenancePlanStatus @default(ACTIVE)
  records        MaintenanceRecord[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([assetId, name])
  @@unique([id, organizationId])
  @@index([organizationId, status])
}

/// A factual service/repair event. planId is optional — ad-hoc work is
/// recorded without a plan. For plan-linked records the due follow-up
/// derives from the plan's recurrence; plan-less records may carry an
/// explicit nextDueOn. A meter reading captured here is written through to
/// AssetMeterReading in the same transaction so "current reading" has a
/// single append-only source of truth.
model MaintenanceRecord {
  id                  String                    @id @default(cuid())
  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationId      String
  asset               Asset                     @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assetId             String
  plan                MaintenancePlan?          @relation(fields: [planId, organizationId], references: [id, organizationId], onDelete: Restrict)
  planId              String?
  performedOn         DateTime                  @db.Date
  title               String
  workPerformed       String?
  providerName        String? // free text; real vendor/cost tracking is issue #17
  performedByMember   Member?                   @relation(fields: [performedByMemberId, organizationId], references: [id, organizationId], onDelete: Restrict)
  performedByMemberId String?
  meter               AssetMeter?               @relation(fields: [meterId, organizationId], references: [id, organizationId], onDelete: Restrict)
  meterId             String?
  meterReading        Decimal?                  @db.Decimal(14, 3)
  nextDueOn           DateTime?                 @db.Date
  notes               String?
  meterReadings       AssetMeterReading[]       @relation("MeterReadingMaintenanceSource")
  changes             MaintenanceRecordChange[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId, assetId, performedOn])
  @@index([organizationId, planId])
}

/// Append-only correction history for a MaintenanceRecord — same contract
/// as InspectionRecordChange: a complete before/after snapshot of the
/// material fields, written atomically with the record update, keyed to the
/// server-side acting identity. planId and the captured meter reading are
/// immutable provenance and are not part of the snapshot.
model MaintenanceRecordChange {
  id             String            @id @default(cuid())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationId String
  record         MaintenanceRecord @relation(fields: [recordId, organizationId], references: [id, organizationId], onDelete: Restrict)
  recordId       String
  note           String? // optional human reason for the correction

  beforePerformedOn         DateTime     @db.Date
  beforeTitle               String
  beforeWorkPerformed       String?
  beforeProviderName        String?
  beforePerformedByMemberId String?
  beforeNextDueOn           DateTime?    @db.Date
  beforeNotes               String?
  afterPerformedOn          DateTime     @db.Date
  afterTitle                String
  afterWorkPerformed        String?
  afterProviderName         String?
  afterPerformedByMemberId  String?
  afterNextDueOn            DateTime?    @db.Date
  afterNotes                String?
  actorAuthIdentity         AuthIdentity @relation(fields: [actorAuthIdentityId], references: [id], onDelete: Restrict)
  actorAuthIdentityId       String
  createdAt                 DateTime     @default(now())

  @@index([recordId, createdAt])
  @@index([organizationId])
}

/// A human-reported factual issue. OPEN/RESOLVED transitions are audited by
/// DefectChange rows. A defect never changes Asset.status by itself — only
/// an explicit admin choice (e.g. the "mark out of service" checkbox at
/// report time or the normal asset edit) sets OUT_OF_SERVICE, and resolving
/// a defect never restores ACTIVE.
model Defect {
  id                 String         @id @default(cuid())
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationId     String
  asset              Asset          @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assetId            String
  reportedOn         DateTime       @db.Date
  reportedByMember   Member?        @relation(fields: [reportedByMemberId, organizationId], references: [id, organizationId], onDelete: Restrict)
  reportedByMemberId String?
  reporterName       String? // free text for non-member reporters
  title              String
  description        String?
  status             DefectStatus   @default(OPEN)
  resolvedOn         DateTime?      @db.Date
  resolutionNotes    String?
  changes            DefectChange[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, assetId])
}

/// Append-only lifecycle audit for a defect — same pattern as
/// TrainingAttendanceChange. REPORTED, RESOLVED, and REOPENED are recorded
/// with the acting admin so "resolved then re-observed" is honest history.
model DefectChange {
  id                  String       @id @default(cuid())
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationId      String
  defect              Defect       @relation(fields: [defectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  defectId            String
  action              DefectAction
  note                String?
  actorAuthIdentity   AuthIdentity @relation(fields: [actorAuthIdentityId], references: [id], onDelete: Restrict)
  actorAuthIdentityId String
  createdAt           DateTime     @default(now())
}

/// A manually-recorded meter on an asset ("engine hours", "odometer",
/// "cycles"). unit is free text — the model must not hardcode a meter kind
/// into all assets. Readings are append-only facts; ARCHIVED meters refuse
/// new readings but keep their history (meter replacement = archive old,
/// create new).
model AssetMeter {
  id                 String              @id @default(cuid())
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationId     String
  asset              Asset               @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assetId            String
  name               String
  unit               String
  status             AssetMeterStatus    @default(ACTIVE)
  readings           AssetMeterReading[]
  maintenancePlans   MaintenancePlan[]
  maintenanceRecords MaintenanceRecord[]
  inspectionRecords  InspectionRecord[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([assetId, name])
  @@unique([id, organizationId])
  @@index([organizationId, assetId])
}

/// One factual meter observation. Readings on one meter are non-decreasing
/// in observation order ((recordedOn, createdAt)) — a physical meter does
/// not run backward, so a lower value is a data error and is rejected. A
/// backdated observation is legal when it fits between its chronological
/// neighbors. Meter reset/replacement is a real event modeled explicitly:
/// archive the old meter and create a new one. "Current reading" is the
/// latest by (recordedOn, createdAt). A reading may record where it was
/// captured (a maintenance or inspection record) — at most one source,
/// enforced by the AssetMeterReading_single_source CHECK constraint.
model AssetMeterReading {
  id                  String             @id @default(cuid())
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationId      String
  meter               AssetMeter         @relation(fields: [meterId, organizationId], references: [id, organizationId], onDelete: Restrict)
  meterId             String
  reading             Decimal            @db.Decimal(14, 3)
  recordedOn          DateTime           @db.Date
  recordedByMember    Member?            @relation(fields: [recordedByMemberId, organizationId], references: [id, organizationId], onDelete: Restrict)
  recordedByMemberId  String?
  maintenanceRecord   MaintenanceRecord? @relation("MeterReadingMaintenanceSource", fields: [maintenanceRecordId, organizationId], references: [id, organizationId], onDelete: Restrict)
  maintenanceRecordId String?
  inspectionRecord    InspectionRecord?  @relation("MeterReadingInspectionSource", fields: [inspectionRecordId, organizationId], references: [id, organizationId], onDelete: Restrict)
  inspectionRecordId  String?
  notes               String?
  createdAt           DateTime           @default(now())

  @@index([meterId, recordedOn])
}

model TrainingAttendanceChange {
  id                  String                   @id @default(cuid())
  organizationId      String
  trainingEventId     String
  memberId            String
  actorAuthIdentityId String
  action              TrainingAttendanceAction
  createdAt           DateTime                 @default(now())

  event  TrainingEvent @relation(fields: [trainingEventId, organizationId], references: [id, organizationId], onDelete: Restrict)
  member Member        @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([trainingEventId, createdAt])
  @@index([memberId])
  @@index([organizationId])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Issue #10 — assets, inventory, storage locations
 */
/**
 * ------------------------------------------------------------------
 */

// Administrative lifecycle for a storage location. ARCHIVED preserves
// the node and everything that references it; there is no delete path
// in the application surface.
enum StorageLocationStatus {
  ACTIVE
  ARCHIVED
}

// Administrative lifecycle for a durable asset. Every transition is an
// explicit human choice — nothing is derived from dates, stock levels,
// or defects. INACTIVE means "not currently in use" (stored, seasonal,
// spare); OUT_OF_SERVICE means a person marked it so (it is NOT an
// inspection result — issue #11); RETIRED means permanently withdrawn.
// None of these values is a safety or readiness conclusion.
enum AssetStatus {
  ACTIVE
  INACTIVE
  OUT_OF_SERVICE
  RETIRED
}

// Human-recorded physical condition — a clerk's note about what someone
// observed, never an inspection-derived or safety-grade value. UNKNOWN
// is the default so no record pretends to a condition nobody stated.
// Structured condition evidence belongs to inspections (issue #11).
enum ConditionStatus {
  UNKNOWN
  GOOD
  FAIR
  DAMAGED
}

enum InventoryItemStatus {
  ACTIVE
  ARCHIVED
}

// A place where assets and stock physically live, arbitrarily nested:
// "SAR Building > Workshop > Shelf A > Cabinet 2". A location sits
// inside exactly ONE container — either a parent location or an Asset
// it is physically part of ("Forward locker" inside "Rescue Boat 1",
// so a vessel's lockers hang off the boat's single identity rather than
// a duplicate location named after it). The parentLocationId /
// containingAssetId mutual exclusion is enforced twice: the
// "StorageLocation_single_container" CHECK constraint rejects a
// dual-container row at the database level (Prisma cannot express the
// XOR — the constraint lives in migration
// 20260928175510_storage_location_single_container), and the domain
// rejects it first for a friendly error. Composite FKs keep both
// inside the organization at the database level. Cycle prevention is
// domain-enforced — a location can never contain itself transitively —
// and containment writes serialize on a per-organization advisory lock
// so concurrent admins can't race a cycle into the graph.
model StorageLocation {
  id                String                @id @default(cuid())
  organizationId    String
  parentLocationId  String?
  containingAssetId String?
  name              String
  description       String?
  status            StorageLocationStatus @default(ACTIVE)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parentLocation  StorageLocation?  @relation("LocationNesting", fields: [parentLocationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  childLocations  StorageLocation[] @relation("LocationNesting")
  containingAsset Asset?            @relation("AssetContainedLocations", fields: [containingAssetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  storedAssets    Asset[]           @relation("AssetStorage")
  inventoryItems  InventoryItem[]

  // Composite-FK target so children/containers enforce same-organization
  // rows at the database level.
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([parentLocationId])
  @@index([containingAssetId])
}

// A durable, individually identifiable thing the organization owns —
// a rescue boat, engine, VHF radio, AED, toolbox. Deliberately a flat
// record with optional identity fields: no per-type subtype tables, no
// equipment taxonomy enforced by schema. `category` is the
// organization's own free-text vocabulary ("boat", "radio", "medical")
// — bounded text, not an enum, so no enum churn as orgs differ.
//
// Relationships:
// - storageLocationId — where it is kept (nullable: unplaced is valid).
// - parentAssetId — physical/administrative containment only
//   ("port engine is part of Rescue Boat 1"). It is NOT an operational
//   dependency graph and asserts nothing about fitness; a child asset
//   keeps its own identity and its own optional storage location (an
//   engine can be part of a boat and temporarily stored in the
//   workshop). Same-org and acyclic, enforced in domain + composite FK.
// - unitId — optional administrative ownership by an internal unit.
//
// `serialNumber` is deliberately NOT unique (manufacturers can reuse
// them); `assetTag` is the organization's own tag and is unique per
// organization when present (NULLs are distinct, so untagged assets
// are unrestricted).
//
// Current location is a mutable fact; durable location/movement
// history is deferred to the generic audit-history work — same
// posture as event-detail edits.
model Asset {
  id                String          @id @default(cuid())
  organizationId    String
  unitId            String?
  parentAssetId     String?
  storageLocationId String?
  name              String
  category          String?
  manufacturer      String?
  model             String?
  serialNumber      String?
  assetTag          String?
  purchaseDate      DateTime?       @db.Date
  // Free-text "where did we buy it" memory. A real Vendor record is
  // deferred to expenses (#17) — this field may later migrate onto it.
  vendor            String?
  status            AssetStatus     @default(ACTIVE)
  condition         ConditionStatus @default(UNKNOWN)
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  unit               Unit?             @relation(fields: [unitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  parentAsset        Asset?            @relation("AssetChildren", fields: [parentAssetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  childAssets        Asset[]           @relation("AssetChildren")
  storageLocation    StorageLocation?  @relation("AssetStorage", fields: [storageLocationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  containedLocations StorageLocation[] @relation("AssetContainedLocations")

  // Issue #11 — inspections, maintenance, defects, meters. All Restrict:
  // asset rows can't be hard-deleted out from under recorded history.
  inspectionRecords  InspectionRecord[]
  maintenancePlans   MaintenancePlan[]
  maintenanceRecords MaintenanceRecord[]
  defects            Defect[]
  meters             AssetMeter[]

  // Issue #15 — explicit incident participation records. Restrict:
  // asset rows can't be hard-deleted out from under incident history.
  incidentParticipations IncidentAsset[]

  // Composite-FK targets so locations/children/units enforce
  // same-organization rows at the database level.
  @@unique([id, organizationId])
  // Optional org-scoped asset tag — NULLs are distinct in Postgres, so
  // untagged assets never collide.
  @@unique([organizationId, assetTag])
  @@index([organizationId, status])
  @@index([organizationId, category])
  @@index([serialNumber])
  @@index([unitId])
  @@index([parentAssetId])
  @@index([storageLocationId])
}

// A quantity-tracked stock item — rope, flares, gloves, batteries,
// first-aid consumables. Deliberately separate from Asset: identity
// fields (serial/tag/parent/contained locations) would be null-noise
// on bulk stock, and quantity/unitOfMeasure would be meaningless on a
// unique asset. `quantity` is an exact DECIMAL(14,3) — "25 m of line"
// or "1.5 gallons cleaner" are legitimate facts; floats would lie.
// No lot tracking, reorder points, FIFO, or stock transactions —
// quantity is simply "how many we have now".
model InventoryItem {
  id                String              @id @default(cuid())
  organizationId    String
  unitId            String?
  storageLocationId String?
  name              String
  category          String?
  quantity          Decimal             @db.Decimal(14, 3)
  unitOfMeasure     String?
  // Free-text purchase-source memory, same deferral as Asset.vendor.
  vendor            String?
  condition         ConditionStatus     @default(UNKNOWN)
  status            InventoryItemStatus @default(ACTIVE)
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  unit            Unit?            @relation(fields: [unitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  storageLocation StorageLocation? @relation(fields: [storageLocationId, organizationId], references: [id, organizationId], onDelete: Restrict)

  // Composite-FK target for future same-organization children
  // (e.g. inspections in issue #11).
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, category])
  @@index([storageLocationId])
}

// ---------------------------------------------------------------------------
// Issue #12 — member availability and contact preferences.
//
// Everything here is a recorded fact: a member (or an admin on their
// behalf) stated an availability status, or configured which channels
// they are willing to be notified on. Nothing computes crew
// sufficiency, launch readiness, ranking, or qualification — the
// organization and qualified personnel decide what availability means
// operationally. See docs/domain-model.md.
// ---------------------------------------------------------------------------

// A member's self-reported availability statement. Deliberately small
// and factual — no LIMITED/percent/role qualifiers: those invite the
// operational inference SARbase deliberately does not make. UNKNOWN is
// both an explicit choice ("clear my status") and the computed fallback
// when nothing has been recorded or the latest statement has expired.
enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  OFF_ISLAND
  UNKNOWN
}

// Append-only availability statement. Each row is one immutable fact:
// "actor recorded that member is <status> [through <until> local date]"
// at createdAt. The CURRENT status is derived at read time — the latest
// row by (createdAt, id); a row whose `until` (a calendar date in the
// organization's timezone, inclusive) has passed no longer describes the
// present and the computed status falls back to UNKNOWN. Expiry never
// invents AVAILABLE — elapsed time is not a statement.
//
// - until is @db.Date: "off island until Oct 12" means through the end
//   of Oct 12 local — an instant would shift it with the server's clock.
// - selfReported records at write time whether the actor was updating
//   their own linked member record; identity links can change later, so
//   deriving it afterwards would not be a durable fact.
// - actorAuthIdentityId is deliberately a PLAIN reference, not a
//   foreign key — the same policy as TrainingAttendanceChange. An FK
//   would either pin identities forever (Restrict) or erase the actor
//   on identity removal (SetNull) — and audit history that disappears
//   with the actor is not audit history. The stored id remains a
//   stable forensic reference after the AuthIdentity is disabled or
//   deleted; while the identity exists the UI resolves it to a friendly
//   name, and after removal it renders as the raw identifier.
//   NOTE: the issue #11 correction-history rows still use Restrict —
//   aligning them is tracked as a separate policy cleanup.
// - Composite FK to Member(id, organizationId) makes a cross-org
//   statement physically impossible; Restrict keeps member rows and
//   their history together.
model MemberAvailabilityUpdate {
  id                  String             @id @default(cuid())
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationId      String
  member              Member             @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Restrict)
  memberId            String
  status              AvailabilityStatus
  until               DateTime?          @db.Date
  note                String?
  selfReported        Boolean            @default(false)
  actorAuthIdentityId String
  createdAt           DateTime           @default(now())

  @@index([memberId, createdAt])
  @@index([organizationId, createdAt])
}

// One mutable row per member recording which notification channels they
// are willing to be contacted on — the consent/preference half of
// contact configuration, established for the later notification work
// (issue #13). This is a PREFERENCE, not proof of deliverability: a
// checked channel only answers "is this member willing", never "will a
// message arrive". The destinations themselves stay on Member
// (email/phone) — this row deliberately stores no addresses, and push
// has no destination yet (willingness is recorded ahead of device
// registration).
//
// Mutable current state rather than append-only history: preference
// provenance/audit belongs to the deferred generic audit work — same
// posture as member detail edits. Cascade keeps the row consistent if a
// member row is ever removed at the database level; the application
// surface never deletes members.
model MemberNotificationPreference {
  id             String   @id @default(cuid())
  organizationId String
  memberId       String
  notifyEmail    Boolean  @default(false)
  notifySms      Boolean  @default(false)
  notifyWhatsapp Boolean  @default(false)
  notifyPush     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  member       Member       @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Cascade)

  // One preference row per member — the composite unique is also the
  // one-to-one FK target on the defining side.
  @@unique([memberId, organizationId])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Issue #13 — notification provider foundation and delivery records.
//
// SARbase records and delivers communication REQUESTS. A Notification row
// is the durable statement "the application asked to send this message";
// each NotificationAttempt row is one append-only record of a provider
// invocation. Delivery state is a factual record — provider acceptance is
// never presented as delivery, and none of it is an operational readiness
// or response conclusion.
// ---------------------------------------------------------------------------

// Delivery channels SARbase can send on. EMAIL is the baseline; SMS,
// WhatsApp, and push are deliberately deferred (the provider seam is
// documented in docs/notifications.md).
enum NotificationChannel {
  EMAIL
}

// The factual lifecycle of a notification request:
// - PENDING    — recorded; either dispatch is in flight or an attempt's
//                outcome is still unknown (a DISPATCHING attempt exists).
// - SUPPRESSED — never dispatched. `statusReason` records the factual
//                cause (e.g. "preference_disabled", "destination_missing")
//                rather than pretending a provider failed.
// - ACCEPTED   — the provider accepted the message for delivery. This is
//                NOT proof of delivery — actual delivery confirmation
//                would require a provider webhook (deferred).
// - FAILED     — dispatched and the provider did not accept it. The last
//                attempt carries the safe error classification.
enum NotificationStatus {
  PENDING
  SUPPRESSED
  ACCEPTED
  FAILED
}

// One provider invocation's recorded outcome. DISPATCHING is written
// before the provider call and resolved to ACCEPTED/FAILED after — a
// permanently DISPATCHING attempt honestly means "we invoked the
// provider; the outcome was never recorded" (e.g. the process died).
enum NotificationAttemptStatus {
  DISPATCHING
  ACCEPTED
  FAILED
}

// A single logical notification request — the application's intent to
// send one message on one channel to one destination.
//
// - Idempotency: (organizationId, idempotencyKey) is unique, and
//   `intentHash` (sha256 of the canonical request intent) detects a key
//   reused with materially different content — replay returns the
//   existing row, conflict fails loudly. Application-level and durable;
//   provider idempotency keys are a second layer where supported.
// - Destination snapshot: `destination` records the address used at
//   request time so history stays accurate when Member.email changes.
//   It is a historical fact, never an authorization input.
// - memberId is nullable: member-targeted requests carry the composite
//   (memberId, organizationId) FK; direct administrative sends (e.g.
//   provider smoke tests to an arbitrary address) leave it null. When
//   present, member notification preferences are enforced before
//   dispatch — see src/lib/domain/notifications.ts.
// - subject/bodyText are stored so retries replay the EXACT message —
//   a notification whose content cannot be reproduced cannot be
//   retried deterministically. They are org-scoped records like any
//   other content field and are never logged (the logging module strips
//   content fields and values).
// - requestedByAuthIdentityId is a deliberately PLAIN scalar (the issue
//   #12 actor policy): notification history must outlive the identity
//   that requested it; display resolves best-effort with raw-id
//   fallback.
// - metadata is small structured context (template params, related
//   record ids) — never message bodies or recipient PII by contract.
model Notification {
  id                        String              @id @default(cuid())
  organizationId            String
  memberId                  String?
  channel                   NotificationChannel
  template                  String
  subject                   String?
  bodyText                  String?
  destination               String?
  metadata                  Json?
  idempotencyKey            String
  intentHash                String
  status                    NotificationStatus  @default(PENDING)
  statusReason              String?
  requestedByAuthIdentityId String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  member       Member?               @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Restrict)
  attempts     NotificationAttempt[]

  // Issue #14 — the callout invitation this request was dispatched for,
  // when applicable. Restrict: notification history is preserved.
  calloutInvitations CalloutInvitation[]

  // Application-level idempotency: one logical request per
  // (organization, key). A second request with the same key is either a
  // replay (same intentHash → return this row) or a conflict (different
  // intentHash → the caller gets an explicit error).
  @@unique([organizationId, idempotencyKey])
  // Composite-FK target so NotificationAttempt enforces same-org rows.
  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([memberId, createdAt])
}

// Append-only record of one provider invocation for a Notification.
// A retry creates a NEW attempt row — previous attempts are never
// overwritten, so the full send history (including the provider's own
// message ids) is preserved.
//
// - attemptNumber is assigned inside a transaction and unique per
//   notification: two concurrent dispatches for the same request race
//   the unique index and the loser aborts before ever calling the
//   provider — the database, not timing, prevents double-sends.
// - provider is the provider name from the abstraction seam ("resend",
//   "fake") — a plain string, so adding providers needs no migration.
// - errorCode/errorSummary are the SAFE failure record: machine code
//   plus a short operator-facing string that never contains the
//   provider's raw message (provider errors can echo recipient
//   addresses and request payloads).
// - resolvedAt is when SARbase recorded the provider outcome. ACCEPTED
//   means "the provider accepted the message" — real delivery would be
//   a later webhook (deferred), not this timestamp.
model NotificationAttempt {
  id                String                    @id @default(cuid())
  organizationId    String
  notificationId    String
  attemptNumber     Int
  provider          String
  status            NotificationAttemptStatus @default(DISPATCHING)
  providerMessageId String?
  errorCode         String?
  errorSummary      String?
  retryable         Boolean                   @default(false)
  attemptedAt       DateTime                  @default(now())
  resolvedAt        DateTime?

  notification Notification @relation(fields: [notificationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([notificationId, attemptNumber])
  @@index([organizationId, attemptedAt])
  @@index([notificationId])
}

// ---------------------------------------------------------------------------
// Issue #14 — Callouts and volunteer response tracking.
//
// A Callout is a durable record that an organization invited members to
// respond to a request for help. SARbase records WHO was invited and HOW
// they responded — it never concludes that a crew is sufficient,
// qualified, ready, or dispatchable. There is deliberately no
// operational severity/readiness data here.
// ---------------------------------------------------------------------------

enum CalloutStatus {
  ACTIVE
  CLOSED
}

enum CalloutAudience {
  ORGANIZATION
  UNIT
  MEMBERS
}

// Factual response states only. Absence of a response is represented by
// a NULL `response` on the invitation ("no response" is derived for
// display — it is not stored as a state).
enum CalloutResponse {
  COMING
  UNAVAILABLE
}

enum CalloutResponseSource {
  TOKEN_LINK
  ACCOUNT
  ADMIN
}

// One activation = one Callout. `activationKey` +
// (organizationId) uniqueness gives durable idempotent creation: a
// double-click or resubmit with the same key replays, and a conflicting
// reuse is rejected by comparing `intentHash` — the same contract as
// Notification.
//
// createdByAuthIdentityId / closedByAuthIdentityId are plain scalar
// references (no FK): history must survive auth identity deletion.
model Callout {
  id                      String          @id @default(cuid())
  organizationId          String
  createdByAuthIdentityId String
  audience                CalloutAudience
  // For UNIT audiences: the unit used for selection, snapshotted. Unit
  // membership at activation time is materialized into invitations —
  // later membership changes never rewrite history.
  unitId                  String?
  title                   String
  message                 String?
  activationKey           String
  intentHash              String
  status                  CalloutStatus   @default(ACTIVE)
  activatedAt             DateTime        @default(now())
  closedAt                DateTime?
  closedByAuthIdentityId  String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  unit         Unit?               @relation(fields: [unitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  invitations  CalloutInvitation[]
  // Issue #15 — at most one incident record may link to this callout
  // (unique calloutId on Incident). The callout itself never changes
  // when an incident is created: its invitations and responses remain
  // the standalone notification/response history.
  incident     Incident?

  @@unique([organizationId, activationKey])
  // Composite-FK target so CalloutInvitation enforces same-org rows.
  @@unique([id, organizationId])
  @@index([organizationId, activatedAt])
}

// A materialized invitation: this member was invited to this callout at
// activation time. The row is the historical record — it is never
// derived from current unit membership, so later roster changes cannot
// rewrite who was actually invited.
//
// `responseTokenHash` is SHA-256 of the bearer token carried in the
// emailed response link. The token is DERIVED — HMAC of
// (calloutId, memberId) under a server-held secret — and never
// persisted anywhere: the Notification row's stored body carries a
// `{callout-response-url}` placeholder that dispatch substitutes with
// the recomputed link at provider-send time.
model CalloutInvitation {
  id                String           @id @default(cuid())
  organizationId    String
  calloutId         String
  memberId          String
  // Nullable while the notification request has not yet been recorded
  // (e.g. dispatch failed at activation); the deterministic
  // notification idempotency key lets a replay link it later.
  notificationId    String?
  responseTokenHash String           @unique
  invitedAt         DateTime         @default(now())
  // Current response state for fast display; the full timeline lives in
  // CalloutResponseChange. NULL = no response.
  response          CalloutResponse?
  respondedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  callout      Callout                 @relation(fields: [calloutId, organizationId], references: [id, organizationId], onDelete: Restrict)
  member       Member                  @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Restrict)
  notification Notification?           @relation(fields: [notificationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  changes      CalloutResponseChange[]

  @@unique([calloutId, memberId])
  // Composite-FK target so CalloutResponseChange enforces same-org rows.
  @@unique([id, organizationId])
  @@index([organizationId, invitedAt])
  @@index([calloutId, response])
}

// Append-only history of response changes on an invitation. The current
// state lives on CalloutInvitation for fast reads; this table preserves
// every meaningful change (first response and later corrections) with
// its factual source — TOKEN_LINK, ACCOUNT, or ADMIN.
//
// actorAuthIdentityId is a plain scalar reference (no FK): for
// TOKEN_LINK responses there is no auth identity (the invitation token
// itself establishes who responded), and history must survive identity
// deletion for the other sources.
model CalloutResponseChange {
  id                  String                @id @default(cuid())
  organizationId      String
  invitationId        String
  previousResponse    CalloutResponse?
  response            CalloutResponse
  source              CalloutResponseSource
  actorAuthIdentityId String?
  note                String?
  createdAt           DateTime              @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitation   CalloutInvitation @relation(fields: [invitationId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([invitationId, createdAt])
}

// ---------------------------------------------------------------------------
// Issue #15 — incident records, timeline, notes, and audit history.
//
// An Incident is the durable ADMINISTRATIVE record: what was reported,
// factual timestamps an operator entered, who participated, which assets
// were recorded as used, human-authored notes, and what was later
// corrected. It is deliberately NOT the callout: a callout is the
// notification/response event; at most one incident may link to a callout
// (unique calloutId), and an incident may exist with no callout at all.
//
// SARbase records incident facts and human-authored notes. It does not
// provide search planning, navigation, tactics, readiness judgments, or
// operational recommendations — there is no severity, priority, verdict,
// or command state anywhere in these models.
// ---------------------------------------------------------------------------

// Minimal administrative lifecycle. OPEN means "the record is in
// progress" — it carries NO operational command-state meaning. CLOSED is
// a human administrative act; corrections remain possible afterwards
// only through the audited correction path (reason required).
enum IncidentStatus {
  DRAFT
  OPEN
  CLOSED
}

// System-generated timeline event kinds. Facts only — each row records
// that a state-changing action happened, not an interpretation of it.
enum IncidentTimelineEventType {
  INCIDENT_CREATED
  STATUS_CHANGED
  CALLOUT_LINKED
  MEMBER_ADDED
  MEMBER_REMOVED
  ASSET_ADDED
  ASSET_REMOVED
  CORRECTION_RECORDED
}

// Human-authored note categories. A note is always a person's recorded
// statement — never a system fact.
enum IncidentNoteKind {
  GENERAL
  AFTER_ACTION
  CLOSING
}

// A durable, organization-scoped incident record.
//
// `reference` is the human-facing identifier ("INC-7") drawn from the
// per-organization IncidentSequence counter inside the create
// transaction — operator references are never raw cuids.
//
// `reportedAt`/`departedAt`/`onSceneAt`/`returnedAt` are optional
// MANUAL factual instants entered by an operator (wall time in the
// organization's timezone). Unknown stays NULL — nothing is fabricated
// from surrounding events, and none of them implies an operational
// judgment.
//
// `summary` is the initial report narrative. It is never silently
// overwritten — every material-field change writes an IncidentChange
// before/after snapshot in the same transaction.
//
// createdByAuthIdentityId / closedByAuthIdentityId are plain scalar
// references (no FK — the scalar actor policy): history must survive
// auth identity deletion; display attribution resolves best-effort.
model Incident {
  id                      String         @id @default(cuid())
  organizationId          String
  // Optional link to the callout this record grew from. Unique: at most
  // one incident per callout (Postgres NULLs are distinct, so unlinked
  // incidents never collide). Set at creation or via the explicit link
  // action; once set it is not relinked — a wrong link is corrected by
  // a human through the audit trail, not by silent retargeting.
  calloutId               String?
  sequence                Int
  reference               String
  title                   String
  summary                 String?
  status                  IncidentStatus @default(DRAFT)
  reportedAt              DateTime?
  departedAt              DateTime?
  onSceneAt               DateTime?
  returnedAt              DateTime?
  openedAt                DateTime?
  closedAt                DateTime?
  createdByAuthIdentityId String
  closedByAuthIdentityId  String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  callout      Callout?                @relation(fields: [calloutId, organizationId], references: [id, organizationId], onDelete: Restrict)
  members      IncidentMember[]
  assets       IncidentAsset[]
  notes        IncidentNote[]
  timeline     IncidentTimelineEvent[]
  changes      IncidentChange[]

  // At most one incident per callout: calloutId is org-unique via the
  // composite FK (a callout belongs to exactly one organization), so
  // (calloutId, organizationId) unique is the full guarantee — and the
  // one-to-one defining side Prisma requires. NULLs are distinct.
  @@unique([calloutId, organizationId])
  @@unique([organizationId, reference])
  // Composite-FK target so every child enforces same-organization rows.
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

// Per-organization monotonic counter for incident references. The
// create path upserts+increments atomically in the same transaction, so
// concurrent creations can never hand out the same number. Gaps are
// acceptable (a rolled-back creation consumes a number) — uniqueness,
// not contiguity, is the contract.
model IncidentSequence {
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationId String       @id
  nextNumber     Int          @default(1)
}

// An explicit factual participation record: "this member was recorded
// as participating in this incident". NEVER inferred from callout RSVP
// state — an admin records it deliberately. `roleNote` is optional free
// factual text ("coxswain", "radio operator" as a fact of record); it is
// NOT a rank, qualification, or operational-authority claim. Removing a
// participant deletes this row — the MEMBER_REMOVED timeline event keeps
// the historical fact of when they were added and removed.
model IncidentMember {
  id                       String   @id @default(cuid())
  organizationId           String
  incidentId               String
  memberId                 String
  roleNote                 String?
  recordedByAuthIdentityId String
  recordedAt               DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  incident     Incident     @relation(fields: [incidentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  member       Member       @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([incidentId, memberId])
  @@unique([id, organizationId])
  @@index([organizationId, incidentId])
  @@index([memberId])
}

// An explicit factual participation record for a durable asset — "this
// asset was recorded as used on this incident". Listing an asset is a
// recordkeeping fact only; it says nothing about readiness. `note` is
// optional free factual text about the recorded use.
model IncidentAsset {
  id                       String   @id @default(cuid())
  organizationId           String
  incidentId               String
  assetId                  String
  note                     String?
  recordedByAuthIdentityId String
  recordedAt               DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  incident     Incident     @relation(fields: [incidentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  asset        Asset        @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([incidentId, assetId])
  @@unique([id, organizationId])
  @@index([organizationId, incidentId])
  @@index([assetId])
}

// One system-generated factual event on the incident record. These are
// the machine's account of state-changing actions — distinct from
// IncidentNote rows, which are human statements.
//
// occurredAt vs createdAt: `occurredAt` is when the recorded event
// happened; `createdAt` is when SARbase wrote the row. For system events
// the only honest occurrence time is the moment of the action, so both
// are set to the same instant — they are kept as separate fields so the
// semantic distinction survives for events that genuinely carry a
// source-supplied time.
//
// `metadata` is a narrow, type-bound JSON payload (e.g.
// {memberId, memberName} for MEMBER_ADDED) — names are snapshotted so
// the history reads correctly even if the member is renamed later.
// actorAuthIdentityId is a scalar reference (no FK): history outlives
// the identity.
model IncidentTimelineEvent {
  id                  String                    @id @default(cuid())
  organizationId      String
  incidentId          String
  type                IncidentTimelineEventType
  occurredAt          DateTime
  actorAuthIdentityId String
  metadata            Json?
  createdAt           DateTime                  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  incident     Incident     @relation(fields: [incidentId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([incidentId, occurredAt])
  @@index([organizationId, occurredAt])
}

// A human-authored note on the incident. Always attributed to a person;
// `occurredAt` is an optional manual instant for recording a past
// observation ("saw the vessel at the dock around 14:00") — when absent
// the note speaks for `createdAt`, the moment it was entered.
//
// `body` is the CURRENT text. Corrections never overwrite history: each
// amendment appends an IncidentNoteCorrection with the before/after
// text, so the original wording is always recoverable.
//
// authorAuthIdentityId is a scalar reference (no FK) — notes must
// survive auth identity deletion.
model IncidentNote {
  id                   String           @id @default(cuid())
  organizationId       String
  incidentId           String
  authorAuthIdentityId String
  kind                 IncidentNoteKind @default(GENERAL)
  body                 String
  occurredAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  incident     Incident                 @relation(fields: [incidentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  corrections  IncidentNoteCorrection[]

  // Composite-FK target so IncidentNoteCorrection enforces same-org rows.
  @@unique([id, organizationId])
  @@index([incidentId, createdAt])
  @@index([organizationId, createdAt])
}

// Append-only correction history for one IncidentNote — the note's
// before/after body plus who corrected it and why. The original text is
// the first correction's beforeBody; intermediate wording is fully
// reconstructable from the chain.
model IncidentNoteCorrection {
  id                  String   @id @default(cuid())
  organizationId      String
  noteId              String
  incidentId          String // denormalized for org-scoped incident history queries
  beforeBody          String
  afterBody           String
  reason              String?
  actorAuthIdentityId String
  createdAt           DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  note         IncidentNote @relation(fields: [noteId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([noteId, createdAt])
  @@index([incidentId, createdAt])
  @@index([organizationId, createdAt])
}

// Append-only audit of material field corrections on an Incident — same
// contract as MaintenanceRecordChange: a complete before/after snapshot
// of the tracked fields written atomically with the update, keyed to
// the server-side acting identity. Lifecycle transitions and
// participant/note changes have their own audit surfaces (timeline
// events and note corrections) and are deliberately not duplicated here.
//
// actorAuthIdentityId is a scalar reference (no FK — the scalar actor
// policy): history must survive auth identity deletion.
model IncidentChange {
  id             String  @id @default(cuid())
  organizationId String
  incidentId     String
  // Human-supplied correction reason. Required by the domain when the
  // incident is CLOSED; optional otherwise.
  reason         String?

  beforeTitle      String
  beforeSummary    String?
  beforeReportedAt DateTime?
  beforeDepartedAt DateTime?
  beforeOnSceneAt  DateTime?
  beforeReturnedAt DateTime?
  afterTitle       String
  afterSummary     String?
  afterReportedAt  DateTime?
  afterDepartedAt  DateTime?
  afterOnSceneAt   DateTime?
  afterReturnedAt  DateTime?

  actorAuthIdentityId String
  createdAt           DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  incident     Incident     @relation(fields: [incidentId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([incidentId, createdAt])
  @@index([organizationId, createdAt])
}
